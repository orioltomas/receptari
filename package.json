{
  "name": "receptari",
  "version": "0.1.0",
  "private": true,
  "description": "Receptari — Vue + Node monorepo per gestionar receptes",
  "packageManager": "pnpm@10.5.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "test:api": "pnpm --filter @receptari/api test",
    "test:web": "pnpm --filter @receptari/web test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter @receptari/api db:generate",
    "db:migrate": "pnpm --filter @receptari/api db:migrate",
    "db:push": "pnpm --filter @receptari/api db:push",
    "db:studio": "pnpm --filter @receptari/api db:studio",
    "format": "prettier --write \"**/*.{ts,vue,json,md}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
