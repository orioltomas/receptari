# Connexió a la base de dades.
# Per defecte: PGlite (Postgres WASM embegut, sense Docker ni servei extern).
#   pglite://                  → in-memory (les dades es perden en tancar)
#   pglite://./data/receptari  → persistència a ./data/receptari
#
# Per canviar a Postgres real (via docker compose o local):
#   postgres://receptari:receptari@localhost:5432/receptari
DATABASE_URL=pglite://./data/receptari

HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001
